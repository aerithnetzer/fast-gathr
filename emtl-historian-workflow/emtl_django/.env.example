# Local defaults. Never commit real credentials.
EMTL_CHATBOT_PROVIDER=unconfigured
EMTL_STAGE_PROVIDER=unconfigured
EMTL_WORKFLOW_REPOSITORY=unconfigured
EMTL_ARTIFACT_STORE=local
EMTL_LOCAL_ARTIFACT_ROOT=outputs/artifacts

# Aerith/PostgreSQL adapter inputs
DATABASE_URL=
EMTL_SQLITE_PATH=
EMTL_DB_CONN_MAX_AGE=60
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
EMTL_DATABASE_API_URL=
EMTL_DATABASE_API_TOKEN=

# Aerith/AWS chatbot adapter inputs
EMTL_AWS_PROVIDER_URL=
EMTL_AWS_PROVIDER_AUTH_TOKEN=
AWS_REGION=eu-west-2
AWS_BEDROCK_MODEL_ID=

# Optional local development provider. Leave disabled for the Aerith handoff.
EMTL_GPU_LOCAL_URL=
EMTL_GPU_LOCAL_TIMEOUT_SECONDS=3600
EMTL_LIVE_REMOTE_LOOKUP=0
EMTL_REMOTE_SSH_CONFIG=
EMTL_REMOTE_SSH_TARGET=
EMTL_QWEN3_LOOKUP_TOOL=
EMTL_REMOTE_MODEL_ROOT=
EMTL_REMOTE_EMBEDDING_MODEL=
EMTL_REMOTE_PYTHON_ENV=
EMTL_REMOTE_LOOKUP_CACHE=
EMTL_REMOTE_PROVIDER_SCRIPT=
EMTL_REMOTE_GENERATION_MODEL=
EMTL_REMOTE_PROVIDER_LOG=

# S3 adapter inputs
EMTL_S3_BUCKET=
EMTL_S3_PREFIX=emtl
EMTL_S3_KMS_KEY_ID=
